# ================================================================
# SoundFlow Data Streaming Pipeline - Environment Configuration
# ================================================================
# Copy this file to .env and update with your settings
# Usage: cp .env.example .env
# ================================================================

# ============================================
# GCP Configuration
# ============================================
GCP_PROJECT=your-gcp-project-id
GCP_REGION=asia-southeast1
# Path to your GCP service account key
GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials/pipeline-sa-key.json

# ============================================
# GCS Configuration
# ============================================
GCS_BUCKET=your-gcs-bucket-name

# ============================================
# BigQuery Configuration
# ============================================
BQ_DATASET=staging_marts

# ============================================
# Dataproc Configuration (optional)
# ============================================
DATAPROC_CLUSTER=soundflow-spark-dev

# ============================================
# EventSim Configuration
# ============================================
# Number of simulated users
EVENTSIM_NUSERS=500
# Historical data range (days ago)
EVENTSIM_FROM_DAYS=30
# End date (0 = today)
EVENTSIM_TO_DAYS=0
# Set to 'true' for continuous streaming, 'false' for batch
EVENTSIM_CONTINUOUS=false

# ============================================
# PostgreSQL Configuration (Local Mode Only)
# ============================================
POSTGRES_USER=soundflow
POSTGRES_PASSWORD=soundflow123
POSTGRES_DB=soundflow

# ============================================
# Python/Windows Encoding (fix UnicodeEncodeError)
# ============================================
PYTHONIOENCODING=utf-8
PYTHONLEGACYWINDOWSSTDIO=utf-8

# ====================
# dbt Configuration
# ====================
DBT_TARGET=local
DBT_PROFILES_DIR=/app/dbt

# ====================
# EventSim Configuration
# ====================
EVENTSIM_NUSERS=100
EVENTSIM_FROM_DAYS=7
EVENTSIM_TO_DAYS=1

# LLM Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here